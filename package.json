{
  "name": "cs2-demo-desk",
  "productName": "CS2 Demo Desk",
  "version": "1.3.1",
  "description": "CS2 personal and tournament demo download manager for Windows",
  "author": "Demo Desk",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/replay-output.test.cjs tests/core.test.js tests/sync-engine.test.cjs tests/session-vault.test.cjs tests/source-parsers.test.cjs tests/pwa-client.test.cjs tests/secret-store.test.cjs tests/replay-controls.test.cjs tests/playback.test.cjs tests/pwa-login.test.cjs tests/download-automation.test.cjs tests/tray.test.cjs tests/steam-network.test.cjs tests/review.test.cjs tests/appearance.test.cjs tests/studio-voice.test.cjs tests/recording-reliability.test.cjs tests/studio-map-hud.test.cjs",
    "test:pwa-login": "node tests/pwa-login-desktop.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:auto": "node tests/auto-desktop.cjs",
    "dist": "electron-builder --win nsis --x64",
    "test:startup": "node tests/startup-desktop.cjs",
    "predist": "node scripts/setup-source2.cjs"
  },
  "dependencies": {
    "@laihoe/demoparser2": "0.42.0",
    "7zip-bin": "5.2.0",
    "ffmpeg-static": "5.3.0",
    "node-forge": "1.4.0",
    "obs-websocket-js": "5.0.8"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "local.demodesk.cs2",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/insight-*",
      "!node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "extraResources": [
      {
        "from": "vendor/7zip",
        "to": "7zip"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/BUILD-INFO.txt"
      },
      {
        "from": "vendor/source2-cli",
        "to": "source2-cli"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico",
      "signExecutable": false
    },
    "asarUnpack": [
      "node_modules/@laihoe/**/*",
      "src/game-console.ps1",
      "src/review-worker.js"
    ],
    "nsis": {
      "artifactName": "CS2-Demo-Desk-Setup-1.3.1-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
